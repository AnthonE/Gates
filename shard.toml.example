# Gates shard config, example. Copy to shard.toml (gitignored — this file
# is per-deployment, .gitignore says why) and edit; `cargo run -p server
# --bin shard` reads shard.toml. Unknown keys are refused; see
# crates/server/src/config.rs.

bind = "127.0.0.1:4433"
seed = 20260731

# Dev only — never on a public shard. Fixed spawn "x,z" in meters: every
# joiner lands on the same point, which is how the wire suites (and two
# local clients on one box) put players inside AOI range without a walk.
# DECISIONS.md §open "dev spawn override".
# dev_spawn = "1024,1024"

# Require a proven identity to join. Default false = this shard takes
# guests, which is what every test and the local dev flow need.
#
# Identity is SIWE (crates/server/src/auth.rs): a joiner signs a nonce this
# shard chose with the key behind the address they claim, and the shard
# recovers the signer — `true` refuses anyone who offers no address or whose
# signature does not verify. DECISIONS.md §open "siwe identity v1".
# require_auth = false

# The SIWE domain: what goes in the message players sign, and it MUST be the
# host they dial — a mismatch refuses every login rather than failing
# quietly. Defaults to the bind host, which is right for a dev shard on
# loopback and wrong for anything behind a DNS name, so a public shard sets
# it (see shard-public.toml).
# domain = "127.0.0.1"

# Where content/*.toml lives (CLAUDE.md wall 7). Default "content",
# resolved against the CWD. The shard refuses to boot on content that
# fails schema, reference, or balance-band checks.
# content_dir = "content"

# The player save file (crates/server/src/store.rs). Unset — the default —
# with require_auth also unset is a shard that remembers nobody: no identity
# means no key to file a save under, so every join builds a fresh character.
# That is what every test and the local dev flow run on.
#
# (Unset with require_auth = true is the middle case: the store's index is in
# memory either way, so a player is remembered for the life of the process. A
# reconnect keeps your inventory; a restart does not.)
#
# Set it and players keep their inventory, position, hp, meters and craft
# queue across a disconnect and a restart. Three things to know before you do:
#
#   1. It needs require_auth = true as well. A save is filed under the
#      identity the admission seam returns, and a guest has none — so with
#      saves armed and admission open, every joiner is remembered by nobody.
#      The shard prints a WARNING at boot if you do that.
#   2. The file is created if absent and pinned to this shard's SEED and
#      CONTENT HASH. Change either and the shard REFUSES TO BOOT rather than
#      hand a hundred players an empty inventory: move the file aside (that
#      is what a wipe is) or restore the old content set.
#   3. The world is NOT in it. Structures, boxes, deployables and hearths
#      live in `world_file` below — this is your character, not your base.
#
# DECISIONS.md §open "player persistence v0".
# save_file = "players.save"

# The WORLD file: bases, boxes and what is in them, deployables, hearth
# stock, bags on the ground, burning fuses, which trees are stumps — and the
# BODIES standing in it.
#
# Unset (the default) generates a fresh island from the seed on every boot,
# which is what every test runs and what this repo did before world
# persistence existed.
#
# A SEPARATE KEY FROM save_file ON PURPOSE, and this is the one that matters
# at wipe time: a wipe destroys the world and keeps the player store, so they
# have to be two files you can delete independently. Either alone is useful —
# a world with no player store keeps your base standing and forgets who you
# are; a player store with no world hands you your inventory on a fresh
# island.
#
# Two things to know:
#
#   1. Pinned to this shard's SEED and CONTENT HASH, same as save_file and
#      for a sharper reason: every base in it stands at a coordinate, and on
#      a different seed that coordinate is somewhere else (often sea). The
#      shard REFUSES TO BOOT rather than start a new island under everyone.
#   2. SINCE SLEEPERS, THIS IS WHERE BODIES LIVE. Without it a restart
#      deletes every body on the shard, and a player who was raided while
#      offline comes back from their store record with everything the raid
#      took. If you run save_file in production, run this too.
#
# DECISIONS.md §open "world persistence v0".
# world_file = "island.world"

# How often the world is written, in ticks (30 ticks = 1 second). Default
# 1800 = every 60 seconds; a clean shutdown always writes one regardless, so
# this only bounds what a CRASH costs.
#
# The reference game's equivalent knob trades crash cost against a shard-wide
# freeze, which is why theirs defaults to ten minutes. Ours has no freeze to
# trade against — the walk is off the sim thread and the write is off it
# again — so the only cost of a shorter interval is disk.
#
# world_save_interval_ticks = 1800

# The status endpoint (crates/server/src/status.rs): plain HTTP on its own
# thread, GET /status.json answering {"players":N,"max_players":100,"tick":T}
# — integers read off the shard's counters, never touching the sim. It is
# what lights the `players` column in the shard list (ci/shardlist.py).
#
# Unset (the default) serves NOTHING: a shard advertises no numbers until
# its operator says where to listen, and putting the URL anywhere public is
# a separate act again. TCP, not UDP — open the port separately from the
# game's; on the public box that means the cloud firewall too (see the
# 2026-08-03 row in DECISIONS.md for why ufw alone buys nothing there).
# DECISIONS.md §open "shard status endpoint v0".
# status_addr = "127.0.0.1:8080"

# The ticket door (crates/server/src/entitle.rs): does a joiner own a copy?
#
# Unset — the default — checks NOTHING, and that is the state every test,
# every community shard and the local dev flow run on. `DECISIONS.md`
# 2026-08-04 is why that is a posture rather than a gap: one build, two
# populations. An OFFICIAL shard is armed and its economy is real; a
# community or training shard runs unarmed and open, and has nothing worth
# cheating for.
#
# Armed, this shard asks scry two questions, both one `balanceOf` underneath:
# `GET /api/ticket/<slug>/of/<wallet>` at join, and
# `POST /api/ticket/<slug>/check` for the whole roster every sweep — because
# a player can sell the ticket and stay logged in.
#
# THREE ANSWERS, NEVER TWO, and this is the part to not get wrong: a shard
# refuses (and kicks) on a definite on-chain zero and NEVER on a failed read.
# An RPC outage that booted every paying player would be worse than the
# freeloader it was trying to catch, so an unanswerable check ADMITS and
# bumps `entitle_unknown` instead. Watch that counter: armed, climbing, with
# `refused_ticket` at zero is a shard checking nothing.
#
# Needs require_auth = true and the shard REFUSES TO BOOT without it — a
# guest has no wallet, so a ticket door over an open door checks nobody.
# entitle_origin = "https://scry.moreright.xyz"

# This title's slug in scry's catalog. Defaults to "gates"; set it only if a
# staging origin files this game under another name.
# entitle_slug = "gates"

# How long one check may take, and how long between roster sweeps. The sweep
# interval IS the security property — it is how long a sold copy keeps
# playing — so it is posted rather than hidden. The timeout must be SHORTER
# than the sweep or a slow origin stacks rounds; the shard refuses the pair
# at boot rather than clamping a number an operator typed.
# entitle_timeout_secs = 6
# entitle_sweep_secs = 120

# ---------------------------------------------------------------------------
# The oldest CLIENT RELEASE this shard admits. Unset ⇒ 0 ⇒ every client that
# can talk to this shard at all, which is the shipping default and is not a
# hole: `PROTO_VER` is an exact gate one step above this and refuses anyone
# whose bytes disagree, before this key is consulted.
#
# THREE VERSION NUMBERS, and this is the third — `crates/protocol/src/version.rs`
# carries the table. The wire's number (`PROTO_VER`) answers "can these two
# parse each other"; it is deliberately stingy and two releases a month apart
# can share it. This answers the question it cannot: "is this client old enough
# to be WRONG about something that is not a byte" — a prediction rule that
# moved, a number that changed in `content/`. That is a judgement about a
# release, which is why it is a config key an operator sets rather than a
# constant somebody has to rebuild to change.
#
# A MINIMUM, not an equality: a client NEWER than this shard is admitted. That
# direction is what keeps a release shippable — a player who updated first must
# not be locked out of a shard nobody has restarted yet — and the incompatibility
# that would actually matter is `PROTO_VER`'s to refuse.
#
# Raising it locks out every installed client below it, so publish the release
# FIRST and raise this after. The `refused_build` counter is how you find out
# you got that order wrong: a number still climbing days later means the build
# you told players to get was never actually published.
# min_client = "0.1.0"

# ---------------------------------------------------------------------------
# The admin lane (admin v0, ALPHA.md §3) and the anomaly log.
# ---------------------------------------------------------------------------
#
# WALLETS TRUSTED WITH ADMIN COMMANDS. Comma-separated, 0x-prefixed. Unset
# means NOBODY is an admin, which is what every test and every community
# shard runs — the same one-build-two-populations posture `entitle_origin`
# takes.
#
# Admin rights are checked against the address SIWE proved at the handshake
# (`auth.rs`), so a client cannot claim them: it never asserts them at all.
# There is no in-game promotion verb and there is not going to be one — a
# shard whose admin list grows at runtime is a shard where one compromised
# key is every key. Case does not matter; a checksummed address pasted from
# a block explorer matches.
#
# A BAD ENTRY REFUSES THE BOOT, whole. A typo'd admin address is an operator
# expecting a privilege they do not have, and finding out now is cheaper than
# finding out during a raid.
#
# The verbs, typed into the game's own chat box (no client build needed —
# the lane is the chat lane, and nothing on the wire moved for it):
#
#   /kick <id>          drop that player now; their body stays as a sleeper
#   /ban <id>           kick, and refuse the wallet for the rest of uptime
#   /say <text>         a line from the house, to everybody, marked [server]
#   /tp <id>            put yourself at that player's feet
#   /give <item> <n>    put items in your own pockets (n defaults to 1)
#   /save               write the world now rather than at the cadence
#
# The id is the number the death screen and the chat prefix already show.
# A ban is remembered as the WALLET (an id means nothing after a reconnect)
# and is MEMORY ONLY at v0: a restart forgets it. Persisting one wants its
# own file with its own format version, which is not built.
# admin_wallets = "0xabc...,0xdef..."

# WHERE THE ANOMALY LOG IS APPENDED. Unset means no log, and every push
# becomes a no-op that costs nothing.
#
# This is the file ALPHA.md §6's gate is about — "zero silent failures in
# the anomaly log" — and it is what turns fifty-odd counters into a
# timeline. One JSON object per line: a watched counter that moved (with
# its delta), every admin act and every refused one, and every `/bug` a
# player filed with the tick and position stamped by the server.
#
# APPEND, never truncated, and it grows without bound by design: it is a
# wipe-cycle artifact you rotate or delete, and shortening the record of a
# bad hour to save bytes is the opposite of the point. A configured log
# that cannot be opened REFUSES THE BOOT rather than downgrading silently —
# an operator who asked for a log and got none would be reading an empty
# file after the incident they wanted it for.
# anomaly_file = "gates-anomaly.jsonl"
