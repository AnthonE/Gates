# Gates shard config, example. Copy to shard.toml (gitignored — this file
# is per-deployment, .gitignore says why) and edit; `cargo run -p server
# --bin shard` reads shard.toml. Unknown keys are refused; see
# crates/server/src/config.rs.

bind = "127.0.0.1:4433"
seed = 20260731

# Dev only — never on a public shard. Fixed spawn "x,z" in meters: every
# joiner lands on the same point, which is how ci/browser_smoke.mjs puts
# two tabs inside AOI range. DECISIONS.md §open "dev spawn override".
# dev_spawn = "1024,1024"

# Require a scry session token to join. Default false = this shard takes
# guests, which is what every test and the local dev flow need.
#
# WARNING, and read it before arming this: the validator is a STUB today
# (crates/server/src/auth.rs). It accepts any non-empty token, so `true`
# proves a joiner CARRIED a credential and not that the credential is real.
# It is not authentication yet. DECISIONS.md §open "scry session auth v0".
# require_auth = false

# Where content/*.toml lives (CLAUDE.md wall 7). Default "content",
# resolved against the CWD. The shard refuses to boot on content that
# fails schema, reference, or balance-band checks.
# content_dir = "content"

# The player save file (crates/server/src/store.rs). Unset — the default —
# with require_auth also unset is a shard that remembers nobody: no identity
# means no key to file a save under, so every join builds a fresh character.
# That is what every test and the local dev flow run on.
#
# (Unset with require_auth = true is the middle case: the store's index is in
# memory either way, so a player is remembered for the life of the process. A
# reconnect keeps your inventory; a restart does not.)
#
# Set it and players keep their inventory, position, hp, meters and craft
# queue across a disconnect and a restart. Three things to know before you do:
#
#   1. It needs require_auth = true as well. A save is filed under the
#      identity the admission seam returns, and a guest has none — so with
#      saves armed and admission open, every joiner is remembered by nobody.
#      The shard prints a WARNING at boot if you do that.
#   2. The file is created if absent and pinned to this shard's SEED and
#      CONTENT HASH. Change either and the shard REFUSES TO BOOT rather than
#      hand a hundred players an empty inventory: move the file aside (that
#      is what a wipe is) or restore the old content set.
#   3. The world is NOT in it. Structures, boxes, deployables and hearths
#      live in `world_file` below — this is your character, not your base.
#
# DECISIONS.md §open "player persistence v0".
# save_file = "players.save"

# The WORLD file: bases, boxes and what is in them, deployables, hearth
# stock, bags on the ground, burning fuses, which trees are stumps — and the
# BODIES standing in it.
#
# Unset (the default) generates a fresh island from the seed on every boot,
# which is what every test runs and what this repo did before world
# persistence existed.
#
# A SEPARATE KEY FROM save_file ON PURPOSE, and this is the one that matters
# at wipe time: a wipe destroys the world and keeps the player store, so they
# have to be two files you can delete independently. Either alone is useful —
# a world with no player store keeps your base standing and forgets who you
# are; a player store with no world hands you your inventory on a fresh
# island.
#
# Two things to know:
#
#   1. Pinned to this shard's SEED and CONTENT HASH, same as save_file and
#      for a sharper reason: every base in it stands at a coordinate, and on
#      a different seed that coordinate is somewhere else (often sea). The
#      shard REFUSES TO BOOT rather than start a new island under everyone.
#   2. SINCE SLEEPERS, THIS IS WHERE BODIES LIVE. Without it a restart
#      deletes every body on the shard, and a player who was raided while
#      offline comes back from their store record with everything the raid
#      took. If you run save_file in production, run this too.
#
# DECISIONS.md §open "world persistence v0".
# world_file = "island.world"

# How often the world is written, in ticks (30 ticks = 1 second). Default
# 1800 = every 60 seconds; a clean shutdown always writes one regardless, so
# this only bounds what a CRASH costs.
#
# The reference game's equivalent knob trades crash cost against a shard-wide
# freeze, which is why theirs defaults to ten minutes. Ours has no freeze to
# trade against — the walk is off the sim thread and the write is off it
# again — so the only cost of a shorter interval is disk.
#
# world_save_interval_ticks = 1800
