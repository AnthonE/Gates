# Rented buddies on the public shard: players buy credit for a Claude buddy
# on elopros.com/agents.html, in the platform's coin, at what its model calls
# cost (scry-forge `meter/rent.py`). This runs `ops/buddy/rent.py`, which
# starts one buddy per wallet with credit (`--friend` that wallet, its own
# key and a tree's name), stops it when the credit is spent, and writes
# what each has spent to /var/lib/gates-rent/public/rent.json for the site.
#
# Once, as root (the key below pays for every rented buddy's calls, so it is
# a Console key and the credit players buy is what pays it back):
#
#   /etc/gates-rent/env      (0600, outside the repo)
#     ANTHROPIC_API_KEY=sk-ant-...
#     CLAUDE_MODEL=claude-sonnet-5-5   # optional; claude_agent.py's default otherwise
#     RENT_SLOTS=6                     # optional; buddies at once
#
#   python3 -m venv ~master/gates-jev/venv && ~master/gates-jev/venv/bin/pip install anthropic
#   sudo cp ops/gates-rent.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now gates-rent
#   journalctl -u gates-rent -f
#
# and the `/gates/rent.json` block in `ops/game-elopros-status.nginx.conf`.
# `ci/deploy_shard.sh` copies jev-bot, claude_agent.py and rent.py to
# ~/gates-jev and restarts this, so a wire bump never strands a buddy.
#
# Spend: each buddy asks its model only while its renter is on the island,
# at most RENT_MAX_HOUR (400) times an hour, and never past its credit.

[Unit]
Description=Gates rented buddies on game.elopros.com:61234
Documentation=https://github.com/AnthonE/Gates/blob/main/ops/buddy/rent.py
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=master
Group=master
WorkingDirectory=/home/master/gates-jev
EnvironmentFile=/etc/gates-rent/env
StateDirectory=gates-rent
StateDirectoryMode=0755
Environment="RENT_STATE=/var/lib/gates-rent"
ExecStart=/home/master/gates-jev/venv/bin/python /home/master/gates-jev/rent.py
Restart=always
RestartSec=15
KillMode=mixed
TimeoutStopSec=30

ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gates-rent

[Install]
WantedBy=multi-user.target
