# A house teammate on the public shard: one free AI player anyone can invite
# with N. `--scripted` makes no model calls, so a bot costs nothing to run;
# it takes plain orders on team chat (`/t follow me`, `/t go get wood`,
# `/t help`; `crates/server/JEV.md`). One unit per bot, one key per bot,
# kept in the bot's own state directory:
#
#   sudo install -d -m 0700 -o gates-agents -g gates-agents /var/lib/gates-teammate/flint
#   sudo -u gates-agents /opt/gates-agents/jev-bot --new-key /var/lib/gates-teammate/flint/agent.key
#   sudo cp gates-teammate@.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now gates-teammate@flint
#   journalctl -u gates-teammate@flint -f
#
# The instance name is the bot's name and its state directory's. It runs as
# `gates-agents`, sandboxed to the game (the account and /opt/gates-agents:
# `ops/gates-village@.service`). The binary is the one `ci/deploy_shard.sh`
# installs to /opt/gates-agents and restarts every teammate on, so a wire
# bump never strands them. The key holds nothing and signs only the shard's
# login; log its address in scry-forge's `docs/money/HELD-KEYS.md`.

[Unit]
Description=Gates house teammate %i on game.elopros.com:61234
Documentation=https://github.com/AnthonE/Gates/blob/main/crates/server/JEV.md
After=network-online.target
Wants=network-online.target
# A shard restart or deploy drops the connection; keep coming back.
StartLimitIntervalSec=0

[Service]
Type=simple
User=gates-agents
Group=gates-agents
WorkingDirectory=/opt/gates-agents
StateDirectory=gates-teammate/%i
StateDirectoryMode=0700
UMask=0077
Environment=GATES_REPORTS_DIR=/var/lib/gates-teammate/%i/reports
# A run is at most a day (`--seconds`); systemd starts the next.
ExecStart=/opt/gates-agents/jev-bot --server game.elopros.com:61234 --agent-key /var/lib/gates-teammate/%i/agent.key --agent-name %i --scripted --seconds 86400
Restart=always
RestartSec=15

# The sandbox: a game client and nothing else. Its own account
# (`gates-agents`), which owns nothing but this unit's state; no home
# directories, no devices, no privileges, read-only everywhere but its state.
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
# Network: the game server and nothing else. 5.161.193.186 is this box,
# what game.elopros.com resolves to; DNS is systemd-resolved on loopback.
# If the box's address moves, move it here too.
IPAddressDeny=any
IPAddressAllow=localhost 5.161.193.186

StandardOutput=journal
StandardError=journal
SyslogIdentifier=gates-teammate-%i

[Install]
WantedBy=multi-user.target
