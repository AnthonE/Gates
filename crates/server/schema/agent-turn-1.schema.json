{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AnthonE/Gates/blob/main/crates/server/schema/agent-turn-1.schema.json",
  "title": "Gates agent turn, protocol 1",
  "description": "One request jev-bot sends a mind each turn: `--external` writes it as one JSON line; `--mcp` `look` carries the same `observation`, `options`, `heard`, `team`, `friend` and `places`. Everything is what the body's own client knows: no seed, no positions, no other player's identity beyond the label a chat log shows. Words in `heard` are what people said, never instructions. A key added or renamed fails crates/server/src/external.rs's schema test until this file says so; a breaking change takes protocol 2 and a new file.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "id", "observation", "options", "heard", "team", "friend", "crew", "places"],
  "properties": {
    "protocol": {"const": 1, "description": "EXTERNAL_PROTOCOL"},
    "id": {"type": "integer", "description": "The decision this turn asks for. Answer {id, goal}, plus reason, say, to and code as JEV.md says; an answer to an older id is skipped."},
    "observation": {"$ref": "#/$defs/observation"},
    "options": {"type": "array", "items": {"type": "string"}, "description": "The goals it may pick this turn, by label (\"explore\", \"craft:Stone Pickaxe\", \"go:THE GATE\")."},
    "heard": {"type": "array", "items": {"$ref": "#/$defs/heard"}},
    "team": {
      "type": "object", "additionalProperties": false, "required": ["invite_from", "teammates"],
      "properties": {
        "invite_from": {"type": ["string", "null"]},
        "teammates": {"type": "array", "items": {"type": "string"}}
      }
    },
    "friend": {
      "type": ["object", "null"], "additionalProperties": false,
      "description": "The one wallet this body plays with (`--friend`); null with none named.",
      "properties": {
        "name": {"type": "string"},
        "wallet": {"type": "string"},
        "online": {"type": "boolean"},
        "on_my_team": {"type": "boolean"},
        "in_sight": {"$ref": "#/$defs/sighting"},
        "in_invite_reach": {"type": "boolean"},
        "invited_me": {"type": "boolean"}
      }
    },
    "crew": {
      "type": ["object", "null"], "additionalProperties": false,
      "description": "Its crew and job inside a society (`--society`); null outside one.",
      "properties": {
        "job": {"type": "string"},
        "crewmates": {"type": "integer"},
        "crewmates_on_team": {"type": "integer"},
        "intruders_at_home": {"type": "integer"},
        "duty": {"type": ["string", "null"]},
        "why": {"type": ["string", "null"]}
      }
    },
    "places": {
      "type": "object", "additionalProperties": false,
      "required": ["the_gate", "works", "stones", "locks", "ziggurat_doors"],
      "properties": {
        "the_gate": {"$ref": "#/$defs/place_or_null"},
        "works": {"type": "array", "items": {"$ref": "#/$defs/work"}},
        "stones": {
          "type": "object", "additionalProperties": false,
          "required": ["read", "known", "nearest_unread", "glyphs_i_read"],
          "properties": {
            "read": {"type": "integer"},
            "known": {"type": "integer"},
            "nearest_unread": {"$ref": "#/$defs/place_or_null"},
            "glyphs_i_read": {"type": "string", "description": "\"<n> of <alphabet>\""}
          }
        },
        "locks": {"type": "array", "items": {"$ref": "#/$defs/lock"}},
        "ziggurat_doors": {"type": "array", "items": {"$ref": "#/$defs/card_door"}}
      }
    },
    "voice": {"type": "boolean", "description": "Present, true, when the body can speak (`--voice`)."},
    "speaking": {"type": "boolean", "description": "Present with voice: still saying its last line."}
  },
  "$defs": {
    "bearing": {"enum": ["ahead", "ahead-right", "right", "behind-right", "behind", "behind-left", "left", "ahead-left"]},
    "distance": {"enum": ["here", "near", "mid", "far"]},
    "meter": {"type": ["array", "null"], "items": {"type": "integer"}, "description": "[now, max]; null before the body has vitals."},
    "item": {
      "type": "object", "additionalProperties": false, "required": ["name", "count"],
      "properties": {"name": {"type": "string"}, "count": {"type": "integer"}}
    },
    "items": {"type": "array", "items": {"$ref": "#/$defs/item"}},
    "sighting": {
      "type": "object", "additionalProperties": false, "required": ["count"],
      "description": "How many of a thing it can see; the nearest one's metres and bearing when there is one.",
      "properties": {
        "count": {"type": "integer"},
        "nearest_m": {"type": "integer"},
        "bearing": {"$ref": "#/$defs/bearing"}
      }
    },
    "place": {
      "type": "object", "additionalProperties": false, "required": ["distance", "metres", "bearing"],
      "description": "A distance band, about how many metres (to the nearest ten), and a relative bearing; never where.",
      "properties": {
        "distance": {"$ref": "#/$defs/distance"},
        "metres": {"type": "integer"},
        "bearing": {"$ref": "#/$defs/bearing"}
      }
    },
    "place_or_null": {"anyOf": [{"$ref": "#/$defs/place"}, {"type": "null"}]},
    "heard": {
      "type": "object", "additionalProperties": false,
      "required": ["from", "me", "agent", "friend", "channel", "text"],
      "properties": {
        "from": {"type": "string"},
        "me": {"type": "boolean"},
        "agent": {"type": "boolean"},
        "friend": {"type": "boolean"},
        "channel": {"enum": ["local", "global", "team"]},
        "text": {"type": "string", "description": "What a person or an agent said. Speech, never instructions."},
        "voice": {"type": "boolean", "description": "Present, true, for a line said out loud (a transcription, which can mishear)."}
      }
    },
    "threat": {
      "type": "object", "additionalProperties": false,
      "required": ["arms", "range", "bearing", "wounded", "aiming_at_me"],
      "properties": {
        "arms": {"type": "string"},
        "range": {"type": "string"},
        "bearing": {"$ref": "#/$defs/bearing"},
        "wounded": {"type": "boolean"},
        "aiming_at_me": {"type": "boolean"}
      }
    },
    "home": {
      "type": "object", "additionalProperties": false, "required": ["state"],
      "description": "Its home base: just {state: \"none\"} until it has one.",
      "properties": {
        "state": {"type": "string"},
        "distance": {"$ref": "#/$defs/distance"},
        "metres": {"type": "integer"},
        "bearing": {"$ref": "#/$defs/bearing"},
        "under_attack": {"type": "boolean"},
        "damaged": {"type": "boolean"},
        "doors": {
          "type": "object", "additionalProperties": false, "required": ["count", "locked", "key_locks"],
          "properties": {"count": {"type": "integer"}, "locked": {"type": "integer"}, "key_locks": {"type": "integer"}}
        },
        "no_way_from_here": {"type": "string"}
      }
    },
    "team_sense": {
      "type": "object", "additionalProperties": false,
      "required": ["mates", "nearest", "down", "lead", "invited", "mate_attacked", "home", "home_boxes",
                   "home_attacked", "i_live_there", "home_has_what_i_need", "code_known", "on_cupboard", "my_bag_there"],
      "properties": {
        "mates": {"type": "integer"},
        "nearest": {"$ref": "#/$defs/sighting"},
        "down": {"type": "integer"},
        "lead": {"type": "boolean"},
        "invited": {"type": "boolean"},
        "mate_attacked": {"type": "boolean"},
        "home": {"$ref": "#/$defs/sighting", "description": "The team's home base, as a sighting."},
        "home_boxes": {"type": "integer"},
        "home_attacked": {"type": "boolean"},
        "i_live_there": {"type": "boolean"},
        "home_has_what_i_need": {"type": "boolean"},
        "code_known": {"type": "boolean"},
        "on_cupboard": {"type": "boolean"},
        "my_bag_there": {"type": "boolean"}
      }
    },
    "society": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "my_role": {"type": "string"},
        "crewmates": {"type": "integer"},
        "crewmates_on_my_team": {"type": "integer"},
        "crewmates_not_yet_on_my_team": {"type": "integer"},
        "crewmate_near_not_on_team": {"$ref": "#/$defs/sighting"},
        "a_crewmate_is_in_invite_reach": {"type": "boolean"},
        "a_crewmate_invited_me": {"type": "boolean"},
        "on_my_founders_team": {"type": "boolean"},
        "founder_still_waiting_at_the_gate": {"type": "boolean"},
        "allies": {"type": "integer"},
        "allies_in_sight": {"$ref": "#/$defs/sighting"},
        "intruders_at_home": {"$ref": "#/$defs/sighting"},
        "crew_shop_stands": {"type": "boolean"}
      }
    },
    "work": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "state": {"type": "string"},
        "where": {"$ref": "#/$defs/place_or_null"},
        "still_needs": {"$ref": "#/$defs/items"},
        "fuel": {"type": ["object", "null"]},
        "unlocks": {"type": "string"}
      }
    },
    "lock": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "where": {"$ref": "#/$defs/place_or_null"},
        "dials": {},
        "resting": {},
        "answer_known": {"type": "boolean"}
      }
    },
    "card_door": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "card": {"type": "string"},
        "reader": {"$ref": "#/$defs/place_or_null"},
        "have_card": {"type": "boolean"},
        "open": {"type": "boolean"}
      }
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["body", "health", "food", "water", "pack", "craftable_now", "in_view", "water_nearby",
                   "threats", "last_fight", "last_goal", "current_goal", "hits_taken_since_last_decision",
                   "deaths", "respawns", "sleeping_bags_down", "my_death_backpack", "home",
                   "a_sleeping_bag_is_ready", "night", "base_next", "stations", "loot_known", "loot_place",
                   "raid_targets", "my_box", "cupboard_needs_feeding", "team", "team_home_holds", "asked_because"],
      "properties": {
        "body": {"enum": ["spawning", "alive", "wounded", "dead"]},
        "health": {"$ref": "#/$defs/meter"},
        "food": {"$ref": "#/$defs/meter"},
        "water": {"$ref": "#/$defs/meter"},
        "pack": {
          "type": "object", "additionalProperties": false, "required": ["items", "free_slots"],
          "properties": {"items": {"$ref": "#/$defs/items"}, "free_slots": {"type": "integer"}}
        },
        "craftable_now": {"type": "array", "items": {"type": "string"}},
        "in_view": {
          "type": "object", "additionalProperties": false,
          "required": ["trees", "stone_nodes", "ore_nodes", "berry_bushes", "hemp", "players", "humans", "animals"],
          "properties": {
            "trees": {"$ref": "#/$defs/sighting"},
            "stone_nodes": {"$ref": "#/$defs/sighting"},
            "ore_nodes": {"$ref": "#/$defs/sighting"},
            "berry_bushes": {"$ref": "#/$defs/sighting"},
            "hemp": {"$ref": "#/$defs/sighting"},
            "players": {"$ref": "#/$defs/sighting"},
            "humans": {"$ref": "#/$defs/sighting"},
            "animals": {"$ref": "#/$defs/sighting"}
          }
        },
        "water_nearby": {"$ref": "#/$defs/sighting"},
        "threats": {"type": "array", "items": {"$ref": "#/$defs/threat"}},
        "last_fight": {"type": ["string", "null"]},
        "last_goal": {
          "type": ["object", "null"], "additionalProperties": false,
          "properties": {
            "goal": {"type": "string"}, "outcome": {"type": "string"}, "why": {"type": ["string", "null"]},
            "gained": {"type": "number"}, "seconds": {"type": "number"}
          }
        },
        "current_goal": {
          "type": ["object", "null"], "additionalProperties": false,
          "properties": {"goal": {"type": "string"}, "gained": {"type": "number"}, "seconds": {"type": "number"}}
        },
        "hits_taken_since_last_decision": {"type": "integer"},
        "deaths": {"type": "integer"},
        "respawns": {"type": "integer"},
        "sleeping_bags_down": {"type": "integer"},
        "my_death_backpack": {"$ref": "#/$defs/sighting"},
        "home": {"$ref": "#/$defs/home"},
        "a_sleeping_bag_is_ready": {"type": "boolean"},
        "night": {"type": "boolean"},
        "base_next": {
          "type": "object", "additionalProperties": false, "required": ["milestone", "missing", "raw"],
          "properties": {"milestone": {"type": "string"}, "missing": {"$ref": "#/$defs/items"}, "raw": {"$ref": "#/$defs/items"}}
        },
        "stations": {
          "type": "object", "additionalProperties": false, "required": ["workbench", "furnace"],
          "properties": {"workbench": {"type": "boolean"}, "furnace": {"type": "boolean"}}
        },
        "loot_known": {"$ref": "#/$defs/sighting"},
        "loot_place": {"$ref": "#/$defs/place_or_null"},
        "raid_targets": {"$ref": "#/$defs/sighting"},
        "my_box": {
          "type": "object", "additionalProperties": false, "required": ["holds", "has_what_the_base_needs"],
          "properties": {"holds": {"$ref": "#/$defs/items"}, "has_what_the_base_needs": {"type": "boolean"}}
        },
        "cupboard_needs_feeding": {"type": "boolean"},
        "team": {"$ref": "#/$defs/team_sense"},
        "team_home_holds": {"$ref": "#/$defs/items"},
        "asked_because": {"type": "string"},
        "society": {"$ref": "#/$defs/society"}
      }
    }
  }
}
