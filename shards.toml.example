# The shards this game publishes — `./ci/shardlist.py` turns this into the
# `scry-shardlist-v1` document the scry launcher's Servers window and the
# game's own intro screen both read. Copy to shards.toml and edit.
#
# The shard list is the GAME's to serve (scry `docs/LAUNCHER.md` §6): the
# launcher renders these rows and never invents, caches or ranks them.
#
# An empty file is a valid, honest document. Both readers render "no shards
# up" for it, which is the correct state when none are running.

[[shard]]
# Stable key. The launcher builds its row key from this, so changing it
# splits one shard into two in anyone's list.
id = "eu-1"

# What a player reads.
name = "Gates EU 1"

# host:port. A NAME, not an address — the public shard's certificate is
# issued for `game.moreright.xyz` (see shard-public.toml) and WebTransport
# needs that name for SNI. An IP here connects and then cannot say who it is
# talking to. The port is the one shard-public.toml binds; it sits in
# 49152-65535 because that range is what the cloud firewall actually passes.
addr = "game.moreright.xyz:61234"

# Optional, free text. The seed is what makes one island different from
# another, so naming it is more useful than naming a map that does not exist.
map = "island 20260731"

# max_players is OPTIONAL and defaults to the sim's own MAX_PLAYERS, read out
# of crates/sim-core/src/limits.rs. Set it only to publish something LOWER
# than the sim allows; higher is refused, because the list would be inviting
# a joiner the shard turns away at the door.
# max_players = 60

# WHERE THIS SHARD'S LIVE PLAYER COUNT IS READ FROM. Optional.
#
# Set it and both readers — the launcher's Servers window and the game's own
# intro screen — poll this url every ten seconds and draw the answer. Leave it
# out and both draw `?`, which is the honest state for a shard that publishes
# no numbers.
#
# It is the `status_addr` endpoint from shard.toml (crates/server/src/
# status.rs), reachable from wherever players are: `GET /status.json` →
# {"players":3,"max_players":100,"tick":123456}. Three things to know:
#
#   1. TCP, not UDP, and a DIFFERENT PORT from the game's. Open it separately
#      — on the public box that means the cloud firewall too, not just ufw
#      (DECISIONS.md, the 2026-08-03 row).
#   2. The count is POLLED, never baked into the list. ci/shardlist.py could
#      have written a number here and deliberately does not: a count fixed at
#      generation time describes the shard as it was whenever someone last ran
#      the script, and the document is then served for weeks. A busy shard
#      reading as empty is exactly what the `?` was protecting against.
#   3. A shard that does not answer costs the row nothing. The reader keeps
#      the last count it got, so a blip does not read as "everyone left".
#
# status_url = "https://game.moreright.xyz:8080/status.json"

# players / ping_ms are deliberately NOT set here. `players` is what
# status_url lights, live, and writing one here would freeze it at whatever it
# was when this file was last edited. `ping_ms` is a measurement only the
# reader can make — the distance from a player to a shard is not a property of
# the shard — so neither this file nor the generator can state one honestly.
# Both readers draw `?` for an absent count.
