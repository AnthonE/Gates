# Build output
/target/
**/target/
**/node_modules/
*.wasm.map

# Cargo.lock IS committed — Gates ships binaries, not a library.

# Local config and state. shard.toml is per-deployment: every knob in the docs
# reads from it, so it is exactly the file that must not be shared.
shard.toml
.env
.env.*
!.env.example

# Dev certs (ECDSA P-256, regenerated on build per NETCODE §2.2) and any key
# material that wanders in. This repo is PUBLIC.
*.pem
*.key
*.p12
certs/

# Runtime artifacts: WAL, snapshots, ledger exports, replays
/data/
*.wal
*.snapshot
anomaly.log

# Trailer work (`ci/film.sh`): tapes, rendered shots, the sound bank and the
# ads cut from them. Hundreds of MB of re-renderable output; the shot and cut
# lists that make it are committed under `ci/film/`.
/film/

# Editors / OS
.DS_Store
.vscode/
.idea/
*.swp

# python bytecode (reference/rip-hooks.py)
__pycache__/
*.pyc

# Fetched texture candidates (~1.3 GB, assets/textures/fetch_gates_texture_candidates.py).
# The queue (CANDIDATES.md and the csv beside it) is committed; the pixels are
# re-fetchable, and a chosen one lands only once it is packed and recorded in
# MANIFEST.md with its licence.
assets/textures/candidates/

# Vendor deliveries under review (~600 MB). What lands in the tree is the
# imported file plus its row in `assets/models/MANIFEST.md`.
assets/models/To Examine/

# Agent worktrees parked under .claude/ (whole duplicate checkouts).
# .claude/skills/ is tracked.
.claude/worktrees/
